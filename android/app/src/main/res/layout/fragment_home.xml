<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/shine_bg">

    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 首页滚动公告条：与网站一致，把店铺要紧的事在顶部滚动展示 -->
            <LinearLayout android:id="@+id/ticker" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:background="@drawable/bg_ticker" android:gravity="center_vertical">

                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_marginStart="12dp" android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_announce" android:tint="@color/shine_pink"
                    android:contentDescription="公告" />

                <TextView android:id="@+id/ticker_text" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:singleLine="true"
                    android:ellipsize="marquee" android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true" android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:paddingEnd="16dp" android:textColor="@color/shine_text"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView android:id="@+id/tv_offline" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:visibility="gone"
                android:background="@color/shine_yellow_soft" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:paddingTop="9dp" android:paddingBottom="9dp"
                android:textSize="12sp" android:textColor="@color/shine_amber_text"
                android:text="离线数据 · 正在展示上次缓存的商品，联网后下拉刷新"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:paddingTop="4dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="热销好物" android:textSize="19sp" android:textStyle="bold"
                    android:textColor="@color/shine_text"
                    android:drawableStart="@drawable/ic_flame" android:drawablePadding="6dp"
                    android:gravity="center_vertical"/>

                <TextView android:id="@+id/tv_count" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textSize="12sp" android:textColor="@color/shine_sub"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="4dp"
                android:paddingBottom="12dp" android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"/>
        </LinearLayout>

        <!-- 空态：没有商品 / 加载失败 -->
        <LinearLayout android:id="@+id/empty_state" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"
            android:orientation="vertical" android:gravity="center" android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <ImageView android:layout_width="56dp" android:layout_height="56dp"
                android:src="@drawable/ic_placeholder" android:alpha="0.55"/>

            <TextView android:id="@+id/tv_empty_title" style="@style/EmptyTitle"
                android:layout_marginTop="12dp" android:text="这里还没有商品"/>

            <TextView android:id="@+id/tv_empty_body" style="@style/EmptyBody"
                android:text="下拉刷新试一次，或稍后再来看看"/>

            <Button android:id="@+id/btn_retry" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:text="重新加载" android:textColor="@color/shine_on_red"
                android:backgroundTint="@color/shine_pink" android:visibility="gone"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/pb_more" android:layout_width="24dp" android:layout_height="24dp"
            android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="16dp"
            android:indeterminateTint="@color/shine_pink" android:visibility="gone"/>
    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
