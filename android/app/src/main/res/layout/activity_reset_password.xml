<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/shine_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/shine_bg" android:elevation="0dp"
        app:title="重置密码" app:titleTextColor="@color/shine_text" app:navigationIconTint="@color/shine_text"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="填写邮件中的「重置令牌」，并设置新密码" android:textSize="13sp" android:textColor="@color/shine_sub"/>

        <EditText android:id="@+id/et_token" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="重置令牌"
            android:inputType="text" android:background="@drawable/bg_input"
            android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

        <EditText android:id="@+id/et_password" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="新密码（至少 8 位）"
            android:inputType="textPassword" android:background="@drawable/bg_input"
            android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

        <EditText android:id="@+id/et_confirm" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="再次输入新密码"
            android:inputType="textPassword" android:background="@drawable/bg_input"
            android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

        <Button android:id="@+id/btn_submit" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="确认重置" android:textColor="@color/shine_on_red" android:backgroundTint="@color/shine_pink"/>
    </LinearLayout>

    <ProgressBar android:id="@+id/pb" android:layout_width="28dp" android:layout_height="28dp"
        android:layout_gravity="center" android:indeterminateTint="@color/shine_pink" android:visibility="gone"/>
</LinearLayout>
