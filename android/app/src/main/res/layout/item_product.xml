<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true" android:focusable="true"
    app:cardBackgroundColor="@color/shine_surface"
    app:cardCornerRadius="16dp" app:cardElevation="0dp"
    app:strokeWidth="1dp" app:strokeColor="@color/shine_yellow_line"
    app:rippleColor="@color/shine_yellow_soft">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="8dp">

        <FrameLayout android:layout_width="match_parent" android:layout_height="132dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/item_img" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:background="@color/shine_yellow_soft"
                app:shapeAppearanceOverlay="@style/RoundedImage"/>

            <TextView android:id="@+id/item_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="精选" android:textSize="10.5sp" android:textColor="@color/shine_pink"
                android:background="@drawable/bg_badge_soft" android:paddingStart="6dp" android:paddingEnd="6dp"
                android:paddingTop="2dp" android:paddingBottom="2dp"
                android:layout_margin="6dp" android:visibility="gone"/>

            <!-- 右下角快速加购：点一下加入购物车，不跳转 -->
            <ImageButton android:id="@+id/item_add" android:layout_width="34dp" android:layout_height="34dp"
                android:layout_gravity="bottom|end" android:layout_margin="6dp"
                android:background="@drawable/bg_add_circle" android:src="@drawable/ic_add"
                android:contentDescription="加入购物车" android:scaleType="centerInside"/>
        </FrameLayout>

        <TextView android:id="@+id/item_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13.5sp" android:textColor="@color/shine_text" android:layout_marginTop="8dp"
            android:minLines="2" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="2dp"/>

        <TextView android:id="@+id/item_cat" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/shine_sub" android:textSize="11.5sp" android:layout_marginTop="2dp"
            android:maxLines="1" android:ellipsize="end"/>

        <TextView android:id="@+id/item_sold" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/shine_amber_text" android:textSize="10.5sp" android:layout_marginTop="3dp"
            android:background="@drawable/bg_sold" android:paddingStart="6dp" android:paddingEnd="6dp"
            android:paddingTop="2dp" android:paddingBottom="2dp"
            android:visibility="gone"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">

            <TextView android:id="@+id/item_price" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textColor="@color/shine_pink"
                android:textStyle="bold" android:textSize="16sp"/>

            <TextView android:id="@+id/item_stock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/shine_amber_text" android:textSize="10.5sp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
