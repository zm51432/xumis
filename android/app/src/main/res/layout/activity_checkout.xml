<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/shine_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/shine_bg" android:elevation="0dp"
        app:title="结算付款" app:titleTextColor="@color/shine_text"
        app:navigationIconTint="@color/shine_text"/>

    <!-- 下单表单 -->
    <ScrollView android:id="@+id/form_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="4dp" android:paddingBottom="24dp">

            <TextView style="@style/SettingsSection" android:text="商品摘要"/>

            <TextView android:id="@+id/tv_items" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/shine_text"
                android:lineSpacingExtra="4dp"/>

            <TextView style="@style/SettingsSection" android:text="收货信息"/>

            <EditText android:id="@+id/et_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="收货人姓名 *"
                android:inputType="textPersonName" android:background="@drawable/bg_input"
                android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

            <EditText android:id="@+id/et_email" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="邮箱 *"
                android:inputType="textEmailAddress" android:background="@drawable/bg_input"
                android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

            <EditText android:id="@+id/et_phone" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="电话（选填）"
                android:inputType="phone" android:background="@drawable/bg_input"
                android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

            <EditText android:id="@+id/et_country" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="国家 / 地区（选填）"
                android:inputType="text" android:background="@drawable/bg_input"
                android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

            <EditText android:id="@+id/et_address" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="详细地址（选填）"
                android:inputType="textPostalAddress" android:background="@drawable/bg_input"
                android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

            <EditText android:id="@+id/et_note" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="订单备注（选填）"
                android:inputType="text" android:background="@drawable/bg_input"
                android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

            <TextView style="@style/SettingsSection" android:text="支付方式"/>

            <RadioGroup android:id="@+id/rg_pay" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal">
                <RadioButton android:id="@+id/rb_paypal" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="PayPal" android:checked="true"/>
                <RadioButton android:id="@+id/rb_wechat" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="微信"/>
                <RadioButton android:id="@+id/rb_alipay" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="支付宝"/>
                <RadioButton android:id="@+id/rb_card" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="信用卡"/>
            </RadioGroup>

            <TextView android:id="@+id/tv_summary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textSize="14sp" android:textColor="@color/shine_text"/>

            <Button android:id="@+id/btn_submit" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="立即付款" android:textColor="@color/shine_on_red"
                android:backgroundTint="@color/shine_pink"/>
        </LinearLayout>
    </ScrollView>

    <!-- 下单成功 -->
    <LinearLayout android:id="@+id/success_layout" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:gravity="center" android:visibility="gone" android:paddingStart="32dp" android:paddingEnd="32dp">

        <ImageView android:layout_width="64dp" android:layout_height="64dp"
            android:src="@drawable/ic_flame" android:tint="@color/shine_pink"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="下单成功" android:textSize="20sp"
            android:textStyle="bold" android:textColor="@color/shine_text"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="请按所选支付方式完成付款，我们会尽快与您确认订单" android:textSize="13sp"
            android:textColor="@color/shine_sub"/>

        <TextView android:id="@+id/tv_order_no" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="15sp"
            android:textColor="@color/shine_pink" android:textStyle="bold"/>

        <Button android:id="@+id/btn_view_order" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="查看订单" android:textColor="@color/shine_on_red"
            android:backgroundTint="@color/shine_pink"/>

        <Button android:id="@+id/btn_done" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="返回首页" android:textColor="@color/shine_pink"
            android:backgroundTint="@color/shine_surface"/>
    </LinearLayout>

    <ProgressBar android:id="@+id/pb" android:layout_width="28dp" android:layout_height="28dp"
        android:layout_gravity="center" android:indeterminateTint="@color/shine_pink" android:visibility="gone"/>
</LinearLayout>
