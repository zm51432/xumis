<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/shine_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/shine_bg" android:elevation="0dp"
        app:title="订单详情" app:titleTextColor="@color/shine_text" app:navigationIconTint="@color/shine_text"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="8dp" android:paddingBottom="24dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tv_order_no" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/shine_text" android:clickable="true" android:focusable="true"
                    android:contentDescription="点击复制订单号"/>
                <TextView android:id="@+id/tv_status" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/shine_pink"
                    android:background="@drawable/bg_badge_soft" android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp"/>
            </LinearLayout>

            <TextView android:id="@+id/tv_copy_hint" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="点击订单号可复制"
                android:textSize="11sp" android:textColor="@color/shine_sub"/>

            <TextView android:id="@+id/tv_status_hint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="商家确认后订单状态会更新；取消 / 售后请点下方「联系客服」"
                android:textSize="11sp" android:textColor="@color/shine_sub" android:lineSpacingExtra="2dp"/>

            <TextView android:id="@+id/tv_created" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp"
                android:textColor="@color/shine_sub"/>

            <TextView android:id="@+id/tv_pay" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="12sp"
                android:textColor="@color/shine_sub"/>

            <TextView style="@style/SettingsSection" android:text="商品明细"/>

            <TextView android:id="@+id/tv_items" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/shine_text"
                android:lineSpacingExtra="4dp"/>

            <TextView style="@style/SettingsSection" android:text="收货信息"/>

            <TextView android:id="@+id/tv_ship" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/shine_text"
                android:lineSpacingExtra="3dp"/>

            <TextView android:id="@+id/tv_note" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="12sp"
                android:textColor="@color/shine_sub" android:visibility="gone"/>

            <!-- 阶段3：费用明细（小计 / 优惠 / 运费 / 税费） -->
            <TextView style="@style/SettingsSection" android:text="费用明细"/>

            <TextView android:id="@+id/tv_charges" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/shine_text"
                android:lineSpacingExtra="4dp"/>

            <!-- 阶段3：物流信息（无运单号时整块隐藏） -->
            <TextView android:id="@+id/tv_section_tracking" style="@style/SettingsSection" android:text="物流信息"
                android:visibility="gone"/>

            <TextView android:id="@+id/tv_tracking_no" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/shine_text"
                android:clickable="true" android:focusable="true" android:visibility="gone"
                android:contentDescription="点击复制运单号"/>

            <TextView android:id="@+id/tv_track_events" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp"
                android:textColor="@color/shine_sub" android:lineSpacingExtra="4dp"
                android:visibility="gone"/>

            <TextView android:id="@+id/tv_total" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="18sp"
                android:textStyle="bold" android:textColor="@color/shine_pink"/>
        </LinearLayout>
    </ScrollView>

    <!-- 底部操作栏：再次购买 / 联系客服，避免订单详情只能看不能做 -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/shine_yellow_line"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/shine_surface"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp"
        android:paddingBottom="10dp" android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_contact" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
            android:text="联系客服" android:textSize="14sp" android:insetTop="0dp" android:insetBottom="0dp"
            android:textColor="@color/shine_pink" app:strokeColor="@color/shine_pink"
            app:cornerRadius="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rebuy" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="46dp" android:layout_marginStart="10dp" android:text="再次购买"
            android:textSize="14sp" android:insetTop="0dp" android:insetBottom="0dp"
            android:textColor="@color/shine_on_red" app:backgroundTint="@color/shine_pink"
            app:cornerRadius="12dp"/>
    </LinearLayout>

    <ProgressBar android:id="@+id/pb" android:layout_width="28dp" android:layout_height="28dp"
        android:layout_gravity="center" android:indeterminateTint="@color/shine_pink" android:visibility="gone"/>
</LinearLayout>
