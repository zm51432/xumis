<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/shine_bg" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">

        <!-- ============ 未登录：登录表单 ============ -->
        <LinearLayout android:id="@+id/box_login" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_panel" android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="登录我的账户" android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/shine_text" android:layout_marginBottom="14dp"/>

            <TextView style="@style/ShineLabel" android:text="邮箱"/>
            <EditText android:id="@+id/et_email" style="@style/ShineInput"
                android:hint="you@example.com" android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"/>

            <TextView style="@style/ShineLabel" android:text="密码"/>
            <EditText android:id="@+id/et_password" style="@style/ShineInput"
                android:hint="请输入密码" android:inputType="textPassword"
                android:autofillHints="password"/>

            <Button android:id="@+id/btn_login" android:layout_width="match_parent"
                android:layout_height="48dp" android:layout_marginTop="16dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:text="登录" android:textColor="@android:color/white"
                android:background="@drawable/bg_btn_primary"/>

            <TextView android:id="@+id/tv_progress" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:visibility="gone"
                android:gravity="center" android:textSize="12sp" android:textColor="@color/shine_sub"
                android:layout_marginTop="8dp" android:text="登录中…"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp">

                <TextView android:id="@+id/tv_go_register" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="还没有账号？立即注册" android:textSize="13sp"
                    android:textColor="@color/shine_pink" android:padding="6dp"/>

                <TextView android:id="@+id/tv_go_forgot" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="忘记密码？"
                    android:textSize="13sp" android:textColor="@color/shine_sub"
                    android:padding="6dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 已登录：账号信息 + 账单/订单 ============ -->
        <LinearLayout android:id="@+id/box_profile" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_panel" android:padding="14dp">

                <TextView android:id="@+id/tv_avatar" android:layout_width="46dp" android:layout_height="46dp"
                    android:gravity="center" android:textSize="20sp" android:textStyle="bold"
                    android:textColor="@android:color/white" android:background="@drawable/bg_btn_primary"
                    android:text="S"/>

                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView android:id="@+id/tv_name" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="@color/shine_text" android:text="—"/>

                    <TextView android:id="@+id/tv_email" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="13sp"
                        android:textColor="@color/shine_sub" android:layout_marginTop="2dp" android:text="—"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="账单与订单" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/shine_text" android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout android:id="@+id/box_orders" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"/>

            <TextView android:id="@+id/tv_no_orders" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:visibility="gone" android:textSize="13sp"
                android:textColor="@color/shine_sub" android:padding="14dp"
                android:background="@drawable/bg_panel"
                android:text="还没有订单，去首页逛逛吧"/>

            <Button android:id="@+id/btn_logout" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="退出登录" android:layout_marginTop="20dp"
                android:textColor="@color/shine_pink"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
