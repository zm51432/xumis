# ERP 运行时配置模板 —— 复制为 config.env 并填入真实值（config.env 绝不入库）
# 所有密钥均从环境变量读取，代码中无硬编码凭据

ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=3306
ERP_DB_NAME=shine_erp
ERP_DB_USER=erp_user
ERP_DB_PASSWORD=<在此填入数据库密码>

# 网站与 ERP 之间的调用密钥（双方保持一致）
ERP_API_KEY=<在此填入随机 API Key>

# ERP 管理员登录口令（首次启动后尽快修改）
ERP_ADMIN_PASSWORD=<在此填入管理员密码>

# Flask 会话签名密钥
ERP_SECRET_KEY=<在此填入随机 Secret>
