<?xml version="1.0" encoding="utf-8"?>
<!-- 账单/订单详情：纯原生页面，替代原先弹出的网页「我的账户」 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/shine_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="@color/shine_pink"
        app:titleTextColor="@android:color/white" app:title="账单详情"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">

            <TextView android:id="@+id/tv_progress" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="加载中…" android:gravity="center"
                android:padding="20dp" android:textColor="@color/shine_sub" android:textSize="13sp"/>

            <TextView android:id="@+id/tv_error" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="16dp"
                android:textColor="@color/shine_pink_dark" android:textSize="13sp"
                android:visibility="gone"/>

            <!-- 概览 -->
            <LinearLayout android:id="@+id/box_summary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_panel" android:padding="16dp"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">

                    <TextView android:id="@+id/tv_order_no" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/shine_text" android:text="—"/>

                    <TextView android:id="@+id/tv_status" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:paddingStart="10dp"
                        android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                        android:background="@drawable/bg_chip_red" android:textSize="11sp"
                        android:textColor="@color/shine_pink_dark" android:text="—"/>
                </LinearLayout>

                <TextView android:id="@+id/tv_time" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textSize="12sp" android:textColor="@color/shine_sub" android:text="—"/>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
                    android:background="@color/shine_yellow_line"/>

                <TextView android:id="@+id/tv_pay" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:textColor="@color/shine_text" android:text="支付方式：—"/>

                <TextView android:id="@+id/tv_total" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textSize="20sp" android:textStyle="bold"
                    android:textColor="@color/shine_pink" android:text="US$0.00"/>
            </LinearLayout>

            <!-- 商品明细 -->
            <LinearLayout android:id="@+id/box_items_panel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="12dp" android:background="@drawable/bg_panel"
                android:padding="14dp" android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="商品明细" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/shine_text"/>

                <LinearLayout android:id="@+id/box_items" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- 阶段3：物流轨迹 -->
            <LinearLayout android:id="@+id/box_tracking" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="12dp" android:background="@drawable/bg_panel"
                android:padding="14dp" android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="物流轨迹" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/shine_text"/>

                <TextView android:id="@+id/tv_tracking" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textSize="13sp" android:lineSpacingExtra="3dp"
                    android:textColor="@color/shine_text" android:text="—"/>

                <LinearLayout android:id="@+id/box_tracking_events" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- 收货与备注 -->
            <LinearLayout android:id="@+id/box_shipping" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="12dp" android:background="@drawable/bg_panel"
                android:padding="14dp" android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="收货信息" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/shine_text" android:layout_marginBottom="8dp"/>

                <TextView android:id="@+id/tv_receiver" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:lineSpacingExtra="4dp" android:textColor="@color/shine_text"
                    android:text="—"/>

                <TextView android:id="@+id/tv_note" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:textSize="12.5sp" android:textColor="@color/shine_sub"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
