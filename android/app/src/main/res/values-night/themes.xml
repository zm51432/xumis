<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      本 App 只有一套浅色视觉（淡黄 + 红）。系统切到深色模式时沿用同一套配色，
      否则底部导航、卡片、输入框会变成深色，和淡黄背景拼在一起很脏。
    -->
    <style name="Theme.ShineApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/shine_pink</item>
        <item name="colorPrimaryVariant">@color/shine_pink_dark</item>
        <item name="colorOnPrimary">@color/shine_on_red</item>
        <item name="colorSecondary">@color/shine_mint</item>
        <item name="colorSecondaryVariant">@color/shine_mint_dark</item>
        <item name="colorSurface">@color/shine_surface</item>
        <item name="android:colorBackground">@color/shine_bg</item>
        <item name="android:textColorPrimary">@color/shine_text</item>
        <item name="android:textColorSecondary">@color/shine_sub</item>
        <item name="android:statusBarColor">@color/shine_bg</item>
        <item name="android:navigationBarColor">@color/shine_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowBackground">@color/shine_bg</item>
    </style>
</resources>
