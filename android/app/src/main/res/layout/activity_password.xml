<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/shine_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/shine_bg" android:elevation="0dp"
        app:title="修改密码" app:titleTextColor="@color/shine_text" app:navigationIconTint="@color/shine_text"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="8dp" android:paddingBottom="24dp">

            <TextView style="@style/SettingsSection" android:text="原密码"/>

            <EditText android:id="@+id/et_old" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="输入原密码"
                android:inputType="textPassword" android:background="@drawable/bg_input"
                android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

            <TextView style="@style/SettingsSection" android:text="新密码"/>

            <EditText android:id="@+id/et_new" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="新密码（至少 8 位）"
                android:inputType="textPassword" android:background="@drawable/bg_input"
                android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

            <TextView style="@style/SettingsSection" android:text="确认新密码"/>

            <EditText android:id="@+id/et_confirm" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="再次输入新密码"
                android:inputType="textPassword" android:background="@drawable/bg_input"
                android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

            <Button android:id="@+id/btn_save" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:text="确认修改" android:textColor="@color/shine_on_red" android:backgroundTint="@color/shine_pink"/>
        </LinearLayout>
    </ScrollView>

    <ProgressBar android:id="@+id/pb" android:layout_width="28dp" android:layout_height="28dp"
        android:layout_gravity="center" android:indeterminateTint="@color/shine_pink" android:visibility="gone"/>
</LinearLayout>
