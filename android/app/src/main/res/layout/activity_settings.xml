<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shine_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/shine_pink"
        app:title="设置"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- ============ 通用 ============ -->
            <TextView style="@style/SettingsSection" android:text="通用" />

            <LinearLayout style="@style/SettingsCard">

                <include
                    android:id="@+id/row_text_zoom"
                    layout="@layout/item_settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_network"
                    layout="@layout/item_settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_cache"
                    layout="@layout/item_settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ============ 内容与存储 ============ -->
            <TextView style="@style/SettingsSection" android:text="内容与存储" />

            <LinearLayout style="@style/SettingsCard">

                <include
                    android:id="@+id/row_catalog"
                    layout="@layout/item_settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_offline"
                    layout="@layout/item_settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ============ 帮助与支持 ============ -->
            <TextView style="@style/SettingsSection" android:text="帮助与支持" />

            <LinearLayout style="@style/SettingsCard">

                <include
                    android:id="@+id/row_status"
                    layout="@layout/item_settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_diag"
                    layout="@layout/item_settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_about"
                    layout="@layout/item_settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_policies"
                    layout="@layout/item_settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ============ 关于 ============ -->
            <TextView style="@style/SettingsSection" android:text="关于" />

            <LinearLayout style="@style/SettingsCard">

                <include
                    android:id="@+id/row_version"
                    layout="@layout/item_settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_share"
                    layout="@layout/item_settings_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="商品图、字体与离线页面均随安装包内置，断网也能浏览商品册与售后条款。"
                android:textColor="@color/shine_sub"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
