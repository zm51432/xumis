<resources>
    <!--
      主题：淡黄色 + 红色。
      旧颜色名（pink/mint）保留不动，只改色值，这样所有布局与图标自动跟随新主题，
      不用逐个文件改引用。新增的语义色名供新页面使用。
    -->
    <color name="shine_pink">#D32F2F</color>          <!-- 主色：中国红 -->
    <color name="shine_pink_dark">#B71C1C</color>     <!-- 主色深：暗红 -->
    <color name="shine_mint">#FFD54F</color>          <!-- 辅色：淡黄/琥珀 -->
    <color name="shine_mint_dark">#B26A00</color>     <!-- 辅色深：暖棕（用于链接/强调文字） -->
    <color name="shine_bg">#FFF9E6</color>            <!-- 页面底色：淡黄 -->
    <color name="shine_text">#3B2A1E</color>          <!-- 正文：暖黑 -->
    <color name="shine_sub">#8B7355</color>           <!-- 次要文字：暖灰棕 -->

    <!-- 新增语义色 -->
    <color name="shine_yellow_soft">#FFF3C4</color>   <!-- 浅黄块（提示条/输入框底） -->
    <color name="shine_yellow_line">#F2E0B0</color>   <!-- 淡黄描边 -->
    <color name="shine_red_soft">#FDEAEA</color>      <!-- 浅红块（来源/冷却提示） -->
    <color name="shine_surface">#FFFFFF</color>       <!-- 卡片白 -->
    <color name="shine_on_red">#FFFFFF</color>        <!-- 红底上的文字 -->
    <color name="shine_amber_text">#9C5B00</color>    <!-- 淡黄底上的文字 -->
</resources>
