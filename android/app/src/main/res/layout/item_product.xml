<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="6dp" android:background="@android:color/white" android:padding="8dp">

    <FrameLayout android:layout_width="match_parent" android:layout_height="140dp">
        <ImageView android:id="@+id/item_img" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:background="@color/shine_pink"/>
        <TextView android:id="@+id/item_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="精选" android:textSize="11sp" android:textColor="@android:color/white"
            android:background="@color/shine_pink" android:padding="3dp" android:layout_margin="6dp"/>
    </FrameLayout>

    <TextView android:id="@+id/item_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:textColor="@color/shine_text" android:layout_marginTop="6dp" android:maxLines="1"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="2dp">
        <TextView android:id="@+id/item_price" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/shine_pink" android:textStyle="bold"/>
        <TextView android:id="@+id/item_cat" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/shine_sub" android:textSize="12sp" android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
