<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="@drawable/bg_splash" android:padding="24dp">

    <!-- logo 白卡：让星心图标在暖色背景上更跳，带柔和投影 -->
    <FrameLayout android:id="@+id/logo_card" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:background="@drawable/bg_logo_card"
        android:padding="18dp" android:layout_marginBottom="14dp">

        <ImageView android:id="@+id/iv_logo" android:layout_width="96dp" android:layout_height="96dp"
            android:src="@drawable/ic_launcher_foreground" android:contentDescription="shine 星心"/>
    </FrameLayout>

    <TextView android:id="@+id/tv_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="shine 星心" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/shine_pink"/>

    <TextView android:id="@+id/tv_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="饰品与手工品 · 官方客户端" android:textSize="14sp" android:layout_marginTop="6dp" android:textColor="@color/shine_sub"/>

    <ProgressBar android:id="@+id/pb" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" style="?android:attr/progressBarStyleLarge"/>

    <TextView android:id="@+id/tv_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:textColor="@color/shine_text" android:textAlignment="center"/>

    <Button android:id="@+id/btn_retry" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="重试连接" android:layout_marginTop="18dp" android:visibility="gone"/>

    <Button android:id="@+id/btn_offline" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="浏览离线商品册" android:layout_marginTop="4dp" android:visibility="gone"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>
</LinearLayout>
