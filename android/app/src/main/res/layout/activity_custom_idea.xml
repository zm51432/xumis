<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/shine_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/shine_bg" android:elevation="0dp"
        app:title="来图定制" app:titleTextColor="@color/shine_text" app:navigationIconTint="@color/shine_text"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="8dp" android:paddingBottom="24dp">

            <EditText android:id="@+id/et_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="你的姓名 *"
                android:inputType="textPersonName" android:background="@drawable/bg_input"
                android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

            <EditText android:id="@+id/et_email" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="联系邮箱 *"
                android:inputType="textEmailAddress" android:background="@drawable/bg_input"
                android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

            <EditText android:id="@+id/et_country" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="国家 / 地区"
                android:inputType="text" android:background="@drawable/bg_input"
                android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:id="@+id/til_category" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:hint="期望品类（选填）">
                <AutoCompleteTextView android:id="@+id/act_category"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="none" android:padding="12dp"
                    android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 参考图：来图定制的核心能力 -->
            <LinearLayout android:id="@+id/layout_photo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:background="@drawable/bg_input"
                android:padding="12dp" android:gravity="center_vertical"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <ImageView android:id="@+id/img_preview" android:layout_width="76dp" android:layout_height="76dp"
                    android:scaleType="centerCrop" android:background="@drawable/bg_image_frame"
                    android:src="@drawable/ic_image" android:contentDescription="参考图预览"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="参考图（选填）" android:textColor="@color/shine_text" android:textStyle="bold"/>
                    <TextView android:id="@+id/tv_photo_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="从相册选择或拍照，帮助工匠更懂你的想法"
                        android:textColor="@color/shine_sub" android:textSize="12sp"/>
                </LinearLayout>
                <ImageButton android:id="@+id/btn_remove_photo" android:layout_width="30dp" android:layout_height="30dp"
                    android:visibility="gone" android:src="@drawable/ic_remove"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="移除参考图" app:tint="@color/shine_sub"/>
            </LinearLayout>

            <EditText android:id="@+id/et_desc" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="描述你的定制想法 *"
                android:inputType="textMultiLine" android:minLines="4" android:gravity="top"
                android:background="@drawable/bg_input"
                android:padding="12dp" android:textColor="@color/shine_text" android:textColorHint="@color/shine_sub"/>

            <Button android:id="@+id/btn_submit" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="提交定制需求" android:textColor="@color/shine_on_red" android:backgroundTint="@color/shine_pink"/>
        </LinearLayout>
    </ScrollView>

    <ProgressBar android:id="@+id/pb" android:layout_width="28dp" android:layout_height="28dp"
        android:layout_gravity="center" android:indeterminateTint="@color/shine_pink" android:visibility="gone"/>
</LinearLayout>
