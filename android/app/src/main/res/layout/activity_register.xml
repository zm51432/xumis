<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/shine_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/shine_pink" app:titleTextColor="@android:color/white"
        app:title="注册新账号"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_panel"
                android:padding="16dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="注册需要先验证邮箱" android:textStyle="bold" android:textSize="15sp"
                    android:textColor="@color/shine_text"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textSize="12sp"
                    android:textColor="@color/shine_sub"
                    android:text="点「发送验证码」后，6 位验证码会发到你的邮箱；10 分钟内有效，60 秒后可重发。"/>

                <TextView style="@style/ShineLabel" android:text="邮箱"/>
                <EditText android:id="@+id/et_email" style="@style/ShineInput"
                    android:hint="you@example.com" android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp">

                    <EditText android:id="@+id/et_code" style="@style/ShineInput"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:hint="6 位验证码" android:inputType="number"
                        android:maxLength="6" android:imeOptions="actionDone"/>

                    <Button android:id="@+id/btn_send_code"
                        android:layout_width="wrap_content" android:layout_height="44dp"
                        android:layout_marginStart="8dp" android:minWidth="96dp"
                        android:insetTop="0dp" android:insetBottom="0dp"
                        android:text="发送验证码" android:textSize="12sp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_btn_primary"/>
                </LinearLayout>

                <TextView android:id="@+id/tv_code_hint" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textSize="12sp" android:textColor="@color/shine_mint_dark"
                    android:visibility="gone"/>

                <TextView style="@style/ShineLabel" android:text="称呼（选填）"/>
                <EditText android:id="@+id/et_name" style="@style/ShineInput"
                    android:hint="怎么称呼你" android:inputType="textPersonName"
                    android:autofillHints="name"/>

                <TextView style="@style/ShineLabel" android:text="密码"/>
                <EditText android:id="@+id/et_password" style="@style/ShineInput"
                    android:hint="至少 8 位" android:inputType="textPassword"
                    android:autofillHints="newPassword"/>

                <TextView style="@style/ShineLabel" android:text="确认密码"/>
                <EditText android:id="@+id/et_password2" style="@style/ShineInput"
                    android:hint="再输入一次" android:inputType="textPassword"
                    android:autofillHints="newPassword"/>

                <TextView android:id="@+id/tv_error" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:textColor="@color/shine_pink_dark" android:textSize="12.5sp"
                    android:visibility="gone"/>

                <Button android:id="@+id/btn_register" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="16dp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    android:text="完成注册并登录" android:textColor="@android:color/white"
                    android:background="@drawable/bg_btn_primary"/>

                <TextView android:id="@+id/tv_progress" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:gravity="center" android:textSize="12sp"
                    android:textColor="@color/shine_sub" android:visibility="gone"
                    android:text="提交中…"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
