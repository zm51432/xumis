<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="8dp" android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card" android:gravity="center_vertical">

    <ImageView android:id="@+id/item_img" android:layout_width="72dp" android:layout_height="72dp"
        android:scaleType="centerCrop" android:background="@color/shine_pink"
        android:contentDescription="product"/>

    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="10dp">

        <TextView android:id="@+id/item_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="2"
            android:textColor="@color/shine_text"/>

        <TextView android:id="@+id/item_price" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/shine_pink" android:layout_marginTop="4dp"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">

            <Button android:id="@+id/btn_minus" android:layout_width="34dp" android:layout_height="34dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="−"
                android:textSize="16sp" style="?android:attr/borderlessButtonStyle"/>

            <TextView android:id="@+id/tv_qty" android:layout_width="34dp" android:layout_height="wrap_content"
                android:gravity="center" android:textSize="14sp" android:textColor="@color/shine_text"
                android:text="1"/>

            <Button android:id="@+id/btn_plus" android:layout_width="34dp" android:layout_height="34dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="+"
                android:textSize="16sp" style="?android:attr/borderlessButtonStyle"/>

            <TextView android:id="@+id/btn_remove" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="删除" android:textSize="12sp"
                android:textColor="@color/shine_sub" android:layout_marginStart="14dp" android:padding="6dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
